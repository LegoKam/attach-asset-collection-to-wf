# Copy to .env and fill in. Never commit .env.
#
# `aio app use <workspace.json> --merge` adds the Adobe I/O Runtime credentials
# (AIO_runtime_*) and any Developer Console credentials (AIO_ims_contexts_*,
# IMS_OAUTH_S2S_*) to this file. Do not type those by hand.

## Adobe I/O Runtime (written by `aio app use`)
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=https://adobeioruntime.net

## IMS organization whose users may call the MCP server
ALLOWED_IMS_ORG_ID='<ORG_ID>@AdobeOrg'

## Adobe Workfront
WORKFRONT_API_URL='https://<instance>.my.workfront.adobe.com'
WORKFRONT_API_VERSION='20.0'

## AEM author hosts the workfront-mcp action may forward user tokens to (comma-separated)
AEM_ALLOWED_HOSTS='author-p<program>-e<environment>.adobeaemcloud.com'
