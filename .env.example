# Copy to .env and fill in. Never commit .env.
# The AIO_* and IMS_OAUTH_S2S_* values are written by `aio app use <workspace.json>`.

## Adobe I/O Runtime (from `aio app use`)
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=https://adobeioruntime.net

## Developer Console OAuth server-to-server credential (from `aio app use`)
AIO_ims_contexts_Credential__in__Workfront__Ext__Doc__Linker__App_client__id=
AIO_ims_contexts_Credential__in__Workfront__Ext__Doc__Linker__App_client__secrets=
AIO_ims_contexts_Credential__in__Workfront__Ext__Doc__Linker__App_technical__account__email=
AIO_ims_contexts_Credential__in__Workfront__Ext__Doc__Linker__App_technical__account__id=
AIO_ims_contexts_Credential__in__Workfront__Ext__Doc__Linker__App_scopes=
AIO_ims_contexts_Credential__in__Workfront__Ext__Doc__Linker__App_ims__org__id=
SERVICE_API_KEY=
IMS_OAUTH_S2S_CLIENT_ID=
IMS_OAUTH_S2S_CLIENT_SECRET=
IMS_OAUTH_S2S_ORG_ID=
IMS_OAUTH_S2S_SCOPES=

## Adobe Workfront
WORKFRONT_API_URL='https://<instance>.testdrive.workfront.adobe.com'
WORKFRONT_API_VERSION='20.0'

## AEM author hosts the workfront-mcp action may forward user tokens to (comma-separated)
AEM_ALLOWED_HOSTS='author-p<program>-e<environment>.adobeaemcloud.com'
